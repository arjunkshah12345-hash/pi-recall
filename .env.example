# Required for free-tier Groq STT, LLM, and TTS.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Supermemory Local defaults. Run: npx supermemory local
# This is the local server, not the hosted Supermemory API.
SUPERMEMORY_LOCAL_URL=http://localhost:6767
SUPERMEMORY_LOCAL_KEY=
SUPERMEMORY_CONTAINER=arjun-pi-home

# Optional Composio tool access.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=arjun
COMPOSIO_TOOLKITS=GITHUB,GOOGLECALENDAR,GMAIL,SLACK

# Wake word. Create a Hey Pi .ppn in Picovoice Console and place it here.
PICOVOICE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=./wakewords/hey-pi.ppn
PORCUPINE_MODEL_PATH=

# Audio behavior.
INPUT_DEVICE=
OUTPUT_DEVICE=
RECORD_SECONDS=8
SAMPLE_RATE=16000
SILENCE_RMS_THRESHOLD=0.012

# Models.
ASSISTANT_MODEL=llama-3.3-70b-versatile
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=troy
